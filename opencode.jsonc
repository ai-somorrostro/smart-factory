{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "grafana": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-grafana",
        "--enabled-tools=search,datasource,influxdb,alerting,dashboard,folder"
      ],
      "enabled": true,
      "environment": {
        "GRAFANA_URL": "http://localhost:3000",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      }
    }
  }
}
