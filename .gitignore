# Variables de entorno y secretos de ejecución (no subir al repositorio).
.env

# Redundancia del entorno de ejecucion y los secretos de Node-RED: el archivo «bda/nodered/.gitignore» es la
# fuente de referencia, pero estos patrones raíz mantienen los secretos en el equipo local incluso si el
# archivo anidado se elimina o se mueve.
**/node_modules/
# Cache de node
**/.npm/
# Credenciales de Node-RED
**/flows_cred.json
**/.flows*.backup
**/.config.nodes.json*
**/.config.runtime.json*
*.backup


# Entornos virtuales de Python (raíz o anidados).
.venv/

# Logs, ruido del sistema operativo y metadatos
*:Zone.Identifier

# Datos generados por los capturadores
sbd/datos/*.csv

# --- SBD capturas: secretos, entorno y datos generados ---
__pycache__/
*.pyc

# Archivos notebook de Jupyter
sbd/notebooks/bambu_influx.ipynb
sbd/notebooks/dobot_influx.ipynb