            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"mir\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mir_status\" and r._field == \"state_id\")\n  |> group(columns: [\"robot\"])\n  |> sort(columns: [\"_time\"])\n  |> elapsed(unit: 1s)\n  |> filter(fn: (r) => r.elapsed <= 60)\n  |> map(fn: (r) => ({ r with estado: if float(v: r._value) == 5.0 then \"En uso\" else \"Parado\" }))\n  |> group(columns: [\"robot\", \"estado\"])\n  |> sum(column: \"elapsed\")\n  |> rename(columns: {elapsed: \"_value\"})",
          "hide": false
        }
      ],
