    {
      "id": 8,
      "title": "Historial_acciones",
      "description": "",
      "type": "table",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "import \"regexp\"\n\nfrom(bucket: \"mir\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mir_status\" and r._field == \"mission_text\")\n  |> filter(fn: (r) => exists r.robot)\n  |> group(columns: [\"robot\"])\n  |> aggregateWindow(every: 1m, fn: last, createEmpty: false)\n  |> filter(fn: (r) => r._value =~ /^(Moving|Docking) to \\x27[^\\x27]+\\x27/)\n  |> map(fn: (r) => {\n      nombre = regexp.replaceAllString(r: /\\x27/, v: regexp.findString(r: /\\x27[^\\x27]+\\x27/, v: r._value), t: \"\")\n      return {r with _value: if r._value =~ /^Docking/ then \"Carga en estación (\" + nombre + \")\" else nombre}\n  })\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"robot\"], valueColumn: \"_value\")\n  |> sort(columns: [\"_time\"], desc: true)\n  |> rename(columns: {_time: \"hora\"})\n  |> keep(columns: [\"hora\", \"mir1\", \"mir2\"])",
          "hide": false
        }
      ],
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 80,
                "color": "red"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "json-view"
            },
            "inspect": false
          }
        },
        "overrides": []
      }
