    {
      "id": 5,
      "title": "Misiones",
      "description": "",
      "type": "status-history",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
