      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "import \"strings\"\n\nfrom(bucket: \"mir\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mir_status\" and r._field == \"mission_text\")\n  |> filter(fn: (r) => exists r.robot)\n  |> group(columns: [\"robot\"])\n  |> last()\n  |> map(fn: (r) => ({\n      robot: r.robot,\n      ejecutando_mision: if r.state_text == \"Executing\" then \"SÍ\" else \"NO\",\n      esperando_obstaculo: if strings.containsStr(v: strings.toLower(v: r._value), substr: \"obstacle\") then \"ESPERANDO OBSTÁCULO\" else \"NO\",\n      mision: r._value,\n      ultima_lectura: r._time\n  }))\n  |> group()",
          "hide": false
        }
      ],
      "options": {
        "colWidth": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "rowHeight": 0.9,
        "showValue": "auto",
        "tooltip": {
          "hideZeros": false,
          "mode": "single",
          "sort": "none"
        }
