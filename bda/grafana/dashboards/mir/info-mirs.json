    {
      "id": 7,
      "title": "Historial",
      "description": "",
      "type": "table",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "import \"regexp\"\n\nfrom(bucket: \"mir\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mir_status\" and r._field == \"mission_text\")\n  |> filter(fn: (r) => exists r.robot)\n  |> group(columns: [\"robot\"])\n  |> aggregateWindow(every: 1m, fn: last, createEmpty: false)\n  |> map(fn: (r) => ({r with _value:\n      if regexp.matchRegexpString(r: /^Moving to \\x27[^\\x27]*\\x27/, v: r._value)\n      then regexp.findString(r: /^Moving to \\x27[^\\x27]*\\x27/, v: r._value)\n      else regexp.replaceAllString(r: /\\s*\\(Current: [0-9]+%\\)\\.?/, v: r._value, t: \"\")\n  }))\n  |> filter(fn: (r) => r._value !~ /^Waiting for new missions/)\n  |> group()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"robot\"], valueColumn: \"_value\")\n  |> sort(columns: [\"_time\"], desc: true)\n  |> rename(columns: {_time: \"hora\"})\n  |> keep(columns: [\"hora\", \"mir1\", \"mir2\"])",
          "hide": false
        }
      ],
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "json-view"
            },
            "inspect": false
          }
        },
        "overrides": []
      }
    },
    {
