      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "from(bucket: \"mir\")\n  |> range(start: -1m)\n  |> filter(fn: (r) => r._measurement == \"mir_status\" and r._field == \"state_id\")\n  |> group(columns: [\"robot\"])\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> map(fn: (r) => ({\n        robot: r.robot,\n        _value: if not exists r.mode_text then \"Idle\"\n                else if r.mode_text == \"Mission\" then \"Automático\"\n                else if r.mode_text == \"Manual\" then \"Manual\"\n                else \"Idle\"\n    }))",
          "hide": false
        }
      ],
