    {
      "id": 3,
      "title": "Posición_home",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "gridPos": {
        "x": 9,
        "y": 6,
        "w": 15,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "query": "home_x = 0.0\nhome_y = 140.0\nhome_z = -40.0\ntol_pos = 15.0\n\nfrom(bucket: \"dobot\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"dobot_telemetry\")\n  |> filter(fn: (r) => r._field == \"pos_x\" or r._field == \"pos_y\" or r._field == \"pos_z\")\n  |> last()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({\n      _time: r._time,\n      _value:\n        if (r.pos_x - home_x) < tol_pos and (home_x - r.pos_x) < tol_pos\n          and (r.pos_y - home_y) < tol_pos and (home_y - r.pos_y) < tol_pos\n          and (r.pos_z - home_z) < tol_pos and (home_z - r.pos_z) < tol_pos\n        then \"EN HOME\" else \"FUERA DE HOME\"\n  }))\n  |> keep(columns: [\"_time\", \"_value\"])",
          "hide": false
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Value$/",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
