# Copia a .env y rellena con valores reales: cp sbd/.env.example sbd/.env
# Formato canonico CLAVE=valor (sin espacios ni comillas).

# --- InfluxDB (notebooks) ---
INFLUX_URL=http://192.168.0.1:8086
INFLUX_TOKEN=cambia-este-token
INFLUX_ORG=mi-organizacion
INFLUX_BUCKET_BAMBU=bambu_maintenance
INFLUX_BUCKET_DOBOT=dobot

# --- Dobot CR5A ---
DOBOT_IP=IP_DOBOT
DOBOT_PORT_FEEDBACK=30004
DOBOT_SAMPLE_INTERVAL=0.5
DOBOT_CSV_FILE=dataset_dobot_cr5a.csv

# --- Bambu Lab H2D 1 ---
BAMBU_H2D_1_NAME=Bambu_H2D_1
BAMBU_H2D_1_IP=IP_EJEMPLO_0001
BAMBU_H2D_1_SN=SN_EJEMPLO_0001
BAMBU_H2D_1_CODE=codigo-ejemplo-1

# --- Bambu Lab H2D 2 ---
BAMBU_H2D_2_NAME=Bambu_H2D_2
BAMBU_H2D_2_IP=IP_EJEMPLO_0002
BAMBU_H2D_2_SN=SN_EJEMPLO_0002
BAMBU_H2D_2_CODE=codigo-ejemplo-2

# --- CSV Bambu ---
BAMBU_CSV_FILE=dataset_bambu_multi_printer.csv
