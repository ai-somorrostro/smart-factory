# Stack de monitorizacion de fabrica inteligente.
# Copiar a .env y sustituir los valores marcados antes del primer arranque.
# Nunca incluir credenciales, tokens ni codigos reales en este archivo.

# URL interna de InfluxDB para los servicios de Docker Compose.
INFLUXDB_URL=http://influxdb:8086

# Configuracion inicial de InfluxDB (solo se aplica con un volumen vacio).
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_SEGURA
INFLUXDB_ORG=smart-factory
INFLUXDB_BUCKET_MIR=mir_robots
INFLUXDB_BUCKET_PRINTER=3d_printers
INFLUXDB_BUCKET_DOBOT=dobot
INFLUXDB_TOKEN=CAMBIAR_POR_UN_TOKEN_DE_ADMIN

# Tokens de los robots MiR.
MIR1_TOKEN=CAMBIAR_POR_EL_TOKEN_DE_MIR1
MIR2_TOKEN=CAMBIAR_POR_EL_TOKEN_DE_MIR2

# Configuracion de Grafana.
GRAFANA_URL=http://grafana:3000
GRAFANA_ORG_NAME=Smartek
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_SEGURA
GF_USERS_ALLOW_ORG_CREATE=false
GF_USERS_AUTO_ASSIGN_ORG=true
GF_USERS_AUTO_ASSIGN_ORG_ID=1

# Configuracion SMTP de Grafana.
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.example.com:587
GF_SMTP_USER=usuario@example.com
GF_SMTP_PASSWORD=CAMBIAR_POR_LA_CONTRASENA_SMTP
GF_SMTP_FROM_ADDRESS=usuario@example.com
GF_SMTP_FROM_NAME=Grafana
GF_SMTP_STARTTLS_POLICY=Opportunistic

# Lo genera grafana-init-org en el volumen mcp-secrets.
# No es necesario definirlo para el primer arranque.
# GRAFANA_SERVICE_ACCOUNT_TOKEN=

# Puertos publicados en el host.
NODE_RED_PORT=1880
INFLUXDB_PORT=8086
GRAFANA_PORT=3000

# Configuracion usada por los scripts de captura.
# Las rutas de salida son relativas a sbd/datos dentro del contenedor.
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=CAMBIAR_POR_EL_MISMO_TOKEN_DE_INFLUXDB
INFLUX_ORG=smart-factory
INFLUX_BUCKET_BAMBU=3d_printers
INFLUX_BUCKET_DOBOT=dobot

DOBOT_IP=CAMBIAR_POR_LA_IP_DEL_DOBOT
DOBOT_PORT_FEEDBACK=30004
DOBOT_SAMPLE_INTERVAL=0.5
DOBOT_CSV_FILE=dataset_dobot_cr5a.csv

BAMBU_H2D_1_NAME=Bambu_H2D_1
BAMBU_H2D_1_IP=CAMBIAR_POR_LA_IP_DE_BAMBU_1
BAMBU_H2D_1_SN=CAMBIAR_POR_EL_NUMERO_DE_SERIE_DE_BAMBU_1
BAMBU_H2D_1_CODE=CAMBIAR_POR_EL_CODIGO_DE_BAMBU_1

BAMBU_H2D_2_NAME=Bambu_H2D_2
BAMBU_H2D_2_IP=CAMBIAR_POR_LA_IP_DE_BAMBU_2
BAMBU_H2D_2_SN=CAMBIAR_POR_EL_NUMERO_DE_SERIE_DE_BAMBU_2
BAMBU_H2D_2_CODE=CAMBIAR_POR_EL_CODIGO_DE_BAMBU_2

BAMBU_CSV_FILE=dataset_bambu_multi_printer.csv
